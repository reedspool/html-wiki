#!/usr/bin/env bash
DIR=@reedspool/html-wiki
CLI=tsdown-output/cli.mts
if [ -d "$(npm root)/$DIR" ]; then
	node "$(npm root)/$DIR/$CLI" "$@"
elif [ -d "$(npm root -g)/$DIR" ]; then
	node "$(npm root -g)/$DIR/$CLI" "$@"
else
	echo "Checked npm root: '$(npm root)'"
	echo "Checked npm root -g: '$(npm root -g)'"
	echo "Error: Unable to find '$DIR' executable's node_modules directory"
	exit 1
fi
